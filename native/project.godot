; Thing Ling native desktop edition — Godot 4.6
config_version=5

[application]
config/name="Thing Ling — A Town of Words"
config/version="2.0.0"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")

[display]
window/size/viewport_width=1440
window/size/viewport_height=900
window/size/window_width_override=1440
window/size/window_height_override=900
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.69, 0.80, 0.78, 1)

[audio]
general/text_to_speech=true
driver/enable_input=false
